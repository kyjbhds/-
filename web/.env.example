# ============================================
# 学生成长管理系统 - 环境变量配置示例
# ============================================

# 复制此文件为 .env 并填入你的真实配置

# 飞书 Base Token
# 获取方式：飞书 Base → 分享 → 复制 token
# 格式：bascnxxxxx
VITE_BASE_TOKEN=

# GLM-4-Flash API Key（智谱AI）
# 获取方式：https://open.bigmodel.cn/ → 注册账号 → 创建API Key
# GLM-4-Flash 是免费模型，适合日常使用
VITE_GLM_API_KEY=

# ============================================
# 飞书机器人配置（API方式）
# ============================================

# 飞书应用 App ID
# 获取方式：飞书开发者后台 → 应用详情 → 凭证与基础信息
VITE_FEISHU_APP_ID=cli_aa8472cc38a4dbd3

# 飞书应用 App Secret
# 获取方式：飞书开发者后台 → 应用详情 → 凭证与基础信息
VITE_FEISHU_APP_SECRET=yfY1qR3vaFqCxJB7ARTgfcOKxaGZQLts

# 飞书群 Chat ID
# 获取方式：通过API获取或联系管理员
VITE_FEISHU_CHAT_ID=oc_e397720d1c21e9059ab16fe8b1c60c21
